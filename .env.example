# Copy to .env.local and fill in. Never commit the real values.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Edge Function secrets — set with `supabase secrets set NAME=value`, never put these in .env.local:
# QR_SIGNING_SECRET=   (>=32 random bytes, base64; the phone never sees it)
# PURGE_CRON_SECRET=   (shared secret for the scheduled purge-expired-files call)
